+func TestFailedRecoveryReportsExhaustedGroup(t *testing.T) {
+	for _, noAlternative := range []bool{false, true} {
+		t.Run(fmt.Sprintf("exhausted=%t", noAlternative), func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				w.WriteHeader(http.StatusNoContent)
+			}))
+			defer server.Close()
+			ctx, cancel := context.WithCancel(pause.WithDefaultManager(service.ContextWithDefaultRegistry(context.Background())))
+			defer cancel()
+			target := server.Listener.Addr().String()
+			first := &recoveryTestOutbound{Adapter: outbound.NewAdapter("test", "first", []string{"tcp"}, nil), control: target}
+			second := &recoveryTestOutbound{Adapter: outbound.NewAdapter("test", "second", []string{"tcp"}, nil), control: target}
+			manager := &recoveryTestManager{items: map[string]adapter.Outbound{"first": first, "second": second}}
+			g, err := NewURLTestGroup(ctx, manager, log.NewNOPFactory().Logger(),
+				[]adapter.Outbound{first, second}, server.URL, time.Hour, 0, time.Hour, time.Second, "priority", false, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer g.Close()
+			g.PostStart(true)
+
+			reports := make(chan string, 1)
+			previous := OnURLTestRecoveryFailed
+			OnURLTestRecoveryFailed = func(tag string) { reports <- tag }
+			defer func() { OnURLTestRecoveryFailed = previous }()
+
+			s := &URLTest{Adapter: outbound.NewAdapter("urltest", "active-group", []string{"tcp"}, nil), group: g, logger: log.NewNOPFactory().Logger()}
+			s.SetProbesPaused(true)
+			first.failed.Store(true)
+			second.failed.Store(noAlternative)
+			before := first.probes.Load()
+			if _, err = s.DialContext(ctx, "tcp", M.ParseSocksaddr("payload.test:443")); err == nil {
+				t.Fatal("expected failed node")
+			}
+			waitForRecovery(t, func() bool { return first.probes.Load() > before && !g.checking.Load() })
+
+			select {
+			case tag := <-reports:
+				if !noAlternative || tag != "active-group" {
+					t.Fatalf("unexpected recovery report for %q", tag)
+				}
+			default:
+				if noAlternative {
+					t.Fatal("group exhaustion was not reported")
+				}
+			}
+		})
+	}
+}
